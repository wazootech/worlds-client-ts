{
  "name": "@worlds/client",
  "version": "0.1.0",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi/openapi.json"
  },
  "imports": {
    "@hey-api/openapi-ts": "npm:@hey-api/openapi-ts@0.98.2",
    "typescript": "npm:typescript@^5.9.2"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "openapi/openapi.json",
      "README.md",
      "LICENSE"
    ]
  },
  "fmt": {
    "exclude": ["src/generated", "openapi/openapi.json"]
  },
  "lint": {
    "exclude": ["src/generated"]
  },
  "tasks": {
    "sync:openapi": "deno -A scripts/sync-openapi.ts",
    "generate": "deno run -A npm:@hey-api/openapi-ts",
    "openapi:check": "deno -A scripts/sync-openapi.ts --check",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "ci": {
      "description": "Formats, lints, checks, and verifies the OpenAPI snapshot",
      "dependencies": ["fmt:check", "lint", "check", "openapi:check"]
    }
  }
}
